{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/john/.claude/hooks/standard-candidate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/john/.claude/hooks/ios-standard-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/john/.claude/hooks/standard-unreviewed-scan.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}